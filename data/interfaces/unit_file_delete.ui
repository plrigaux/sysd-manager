<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name unit_file_delete.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.6"/>
  <template class="UnitFileDeleteDialog" parent="AdwDialog">
    <property name="child">
      <object class="AdwToolbarView">
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkLabel">
                <property name="css-classes">title-2</property>
                <property name="label">Delete Unit File</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton">
                <property name="css-classes">selection-mode</property>
                <property name="label">Are you sure</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkButton">
                    <property name="css-classes">pill</property>
                    <property name="halign">start</property>
                    <property name="label">Cancel</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="css-classes">destructive-action
pill</property>
                    <property name="halign">end</property>
                    <property name="label">Delete</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
      </object>
    </property>
    <property name="content-height">200</property>
    <property name="content-width">200</property>
    <property name="title">fgydfghfg</property>
    <style>
      <class name="alert"/>
    </style>
  </template>
</interface>
