<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name creator_end_page.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.6"/>
  <template class="LaunchCreatorPage" parent="AdwNavigationPage">
    <property name="child">
      <object class="AdwClamp" id="ewqr">
        <property name="child">
          <object class="GtkBox">
            <property name="margin-bottom">12</property>
            <property name="margin-top">12</property>
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes" context="create_unit" comments="Prefererence group after creation options">After creation</property>
                <child>
                  <object class="AdwSwitchRow" id="daemon_reload_switch">
                    <property name="action-name">creator.daemon-reload</property>
                    <property name="action-target">true</property>
                    <property name="subtitle" translatable="yes" context="create_unit" comments="switch row subtitle">Reload systemd config</property>
                    <property name="title" translatable="yes" context="create_unit" comments="switch row title">Daemon Reload</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="enable_switch">
                    <property name="subtitle">Enable Unit after creation</property>
                    <property name="title">Enable</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="start_switch">
                    <property name="subtitle" translatable="yes" context="create_unit" comments="Switch row subtitle">Start Unit after creation</property>
                    <property name="title" translatable="yes" context="create_unit" comments="Option to start after creation">Start</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="artefacts_group"/>
            </child>
          </object>
        </property>
      </object>
    </property>
    <property name="tag">launch-page</property>
    <property name="title">Launchd</property>
  </template>
</interface>
