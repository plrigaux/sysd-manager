<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name mydrop.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="MyDropDown" parent="AdwActionRow">
    <child>
      <object class="GtkBox" id="arrow_box">
        <property name="valign">center</property>
        <child>
          <object class="GtkImage">
            <property name="accessible-role">presentation</property>
            <property name="icon-name">pan-down-symbolic</property>
            <style>
              <class name="dropdown-arrow"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkPopover" id="popover">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkSearchEntry" id="search_entry">
                    <property name="max-width-chars">6</property>
                    <!-- Translators: placeholder text of the search entry from AdwComboRow.
                         It should be phrased as a verb -->
                    <property name="placeholder-text" translatable="yes">Search</property>
                    <property name="visible">False</property>
                    <property name="width-chars">6</property>
                    <signal name="search-changed" handler="search_changed_cb" swapped="True"/>
                    <signal name="stop-search" handler="search_stop_cb" swapped="True"/>
                    <style>
                      <class name="combo-searchbar"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="child">
                      <object class="GtkListView" id="list">
                        <property name="single-click-activate">True</property>
                        <property name="tab-behavior">item</property>
                        <signal name="activate" handler="row_activated_cb" swapped="True"/>
                      </object>
                    </property>
                    <property name="max-content-height">400</property>
                    <property name="propagate-natural-height">True</property>
                    <property name="propagate-natural-width">True</property>
                  </object>
                </child>
              </object>
            </property>
            <property name="height-request">350</property>
            <property name="width-request">300</property>
            <signal name="notify::visible" handler="notify_popover_visible_cb" swapped="True"/>
            <style>
              <class name="menu"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="combo"/>
    </style>
  </template>
</interface>
