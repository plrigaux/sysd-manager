<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name clean_dialog.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.6"/>
  <template class="CLEAN_DIALOG" parent="AdwWindow">
    <property name="content">
      <object class="AdwToolbarView">
        <property name="bottom-bar-style">raised</property>
        <property name="content">
          <object class="GtkBox">
            <property name="margin-bottom">5</property>
            <property name="margin-end">5</property>
            <property name="margin-start">5</property>
            <property name="margin-top">5</property>
            <property name="orientation">vertical</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkLabel" id="window_title">
                <property name="css-classes">title-2</property>
                <property name="label">Clean</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="window_subtitle">
                <property name="css-classes">subtitle
dim-label</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="check_button_box">
                <property name="margin-start">46</property>
                <property name="orientation">vertical</property>
              </object>
            </child>
          </object>
        </property>
        <property name="top-bar-style">raised</property>
        <child type="bottom">
          <object class="AdwHeaderBar">
            <property name="height-request">50</property>
            <property name="show-back-button">False</property>
            <property name="show-end-title-buttons">False</property>
            <property name="show-start-title-buttons">False</property>
            <property name="show-title">False</property>
            <child type="end">
              <object class="GtkButton" id="clean_button">
                <property name="css-classes">suggested-action
text-button
pill</property>
                <property name="halign">end</property>
                <property name="label" translatable="yes" context="clean" comments="button">Clean</property>
                <property name="sensitive">False</property>
                <signal name="clicked" handler="clean_button_clicked" swapped="True"/>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="action-name">window.close</property>
                <property name="css-classes">text-button
pill</property>
                <property name="halign">end</property>
                <property name="label" translatable="yes" context="clean" comments="button">Cancel</property>
                <property name="sensitive">False</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <property name="modal">True</property>
  </template>
</interface>
